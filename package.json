{
  "name": "dsh-retry",
  "version": "0.3.0",
  "description": "Adds a native “Restart DeepSeek Harness” entry to the Windows tray menu and the account menu.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/asar.test.js test/patch.test.js test/desktop-helper.test.js test/index.test.js",
    "check": "node scripts/check-syntax.mjs",
    "build": "node scripts/build-patched.mjs",
    "verify": "node scripts/verify-patched.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "tray",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kouzerror/dsh-retry.git"
  },
  "homepage": "https://github.com/kouzerror/dsh-retry#readme",
  "bugs": {
    "url": "https://github.com/kouzerror/dsh-retry/issues"
  },
  "author": "kouzerror",
  "license": "MIT"
}
